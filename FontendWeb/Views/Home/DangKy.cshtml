@model ApartmentManagement.Models.Manager

<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css">
</head>

<body>
    <main class="auth">
        <header id="header" class="header">
            <h1>Đăng ký tài khoản mới</h1>
            <p style="text-align: center;">
                Đã có tài khoản? <a href="/Home/DangNhap">Đăng nhập</a>
            </p>
        </header>
        <!-- form -->
        <form class="auth-form" asp-action="Register" method="post">

            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="text" id="inputFullName" asp-for="FullName" class="form-control" placeholder="Họ và tên" required>
                    <label for="inputFullName">Họ và tên</label>
                    <!-- Display error message for FullName -->
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div><!-- /.form-group -->
            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="text" id="inputUsername" asp-for="Username" class="form-control" placeholder="Tài khoản" required>
                    <label for="inputUsername">Tài khoản</label>
                    <!-- Display error message for Username -->
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
            </div><!-- /.form-group -->
            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="password" id="inputPassword" asp-for="Password" class="form-control" placeholder="Mật khẩu" required>
                    <label for="inputPassword">Mật khẩu</label>
                    <!-- Display error message for Password -->
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div><!-- /.form-group -->
            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="text" id="inputPhoneNumber" asp-for="PhoneNumber" class="form-control" placeholder="Số điện thoại" required>
                    <label for="inputPhoneNumber">Số điện thoại</label>
                    <!-- Display error message for PhoneNumber -->
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div><!-- /.form-group -->
            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="email" id="inputEmail" asp-for="Email" class="form-control" placeholder="Email" required autofocus>
                    <label for="inputEmail">Email</label>
                    <!-- Display error message for Email -->
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div><!-- /.form-group -->
            
            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="text" id="inputAddress" asp-for="Address" class="form-control" placeholder="Địa chỉ" required>
                    <label for="inputAddress">Địa chỉ</label>
                    <!-- Display error message for Address -->
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div><!-- /.form-group -->
            <!-- .form-group -->
            <div class="form-group">
                <button class="btn btn-lg btn-primary btn-block" type="submit">Đăng ký</button>
            </div><!-- /.form-group -->
            <!-- Display error messages -->
            @if (ViewData["Errors"] != null)
            {
                <div class="alert alert-danger text-center">
                    @foreach (var error in (List<string>)ViewData["Errors"])
                    {
                        <p>@error</p>
                    }
                </div>
            }

            <!-- thông báo lỗi -->
            @if (ViewData["Message"] != null)
            {
                <div class="alert alert-success text-center">
                    @ViewData["Message"]
                </div>
            }

            <!-- liên kết chính sách -->
            <p class="text-center text-muted mb-0">
                Khi tạo tài khoản, bạn đồng ý với <a href="#">Điều khoản sử dụng</a> và <a href="#">Chính sách quyền riêng tư</a>.
            </p>
        </form><!-- /.auth-form -->
        <!-- copyright -->
        <footer class="auth-footer"> © 2024 All Rights Reserved. </footer>
    </main><!-- /.auth -->
    <!-- BEGIN BASE JS -->
    <script src="~/assets/vendor/jquery/jquery.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/popper.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.min.js"></script>
    <!-- END BASE JS -->
    <!-- BEGIN PLUGINS JS -->
    <script src="~/assets/vendor/particles.js/particles.min.js"></script>
    <!-- END PLUGINS JS -->
    <!-- BEGIN THEME JS -->
    <script src="~/assets/javascript/theme.min.js"></script>
    <!-- END THEME JS -->
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-116692175-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', 'UA-116692175-1');
    </script>
</body>

</html>
