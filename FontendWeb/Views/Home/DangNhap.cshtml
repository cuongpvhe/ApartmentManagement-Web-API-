@model ApartmentManagement.Models.Manager

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Đăng nhập</title>
    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css">
</head>
<body>
    <main class="auth">
        <header id="header" class="header">
            <h7>Đăng nhập hệ thống quản lý Nhà Cho thuê</h7>
        </header>
        <!-- form -->
        <form class="auth-form" asp-action="Authenticate" method="post">
            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="text" id="inputUser" asp-for="Username" class="form-control" placeholder="Username" autofocus="">
                    <label for="inputUser">Tài khoản</label>
                </div>
            </div><!-- /.form-group -->
            <!-- .form-group -->
            <div class="form-group">
                <div class="form-label-group">
                    <input type="password" id="inputPassword" asp-for="Password" class="form-control" placeholder="Password">
                    <label for="inputPassword">Mật Khẩu</label>
                </div>
            </div><!-- /.form-group -->
            <!-- .form-group -->
            <div class="form-group">
                <button class="btn btn-lg btn-primary btn-block" type="submit">Đăng nhập</button>
            </div><!-- /.form-group -->
            
            <!-- recovery links -->
            <div class="text-center pt-3">
                <a class="nav-link py-2" href="@Url.Action("ForgotPassword", "Home")">Quên mật khẩu?</a>
            </div><!-- /recovery links -->
            <div class="form-group text-center mt-3">
                <p>Chưa có tài khoản? <a href="/Home/DangKy">Đăng ký</a></p>
            </div>

            @if (ViewData["Message"] != null)
            {
                <div class="alert alert-danger text-center">
                    @ViewData["Message"]
                </div>
            }
        </form><!-- /.auth-form -->
    </main><!-- /.auth -->
    <!-- BEGIN BASE JS -->
    <script src="~/assets/vendor/jquery/jquery.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/popper.min.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.min.js"></script> <!-- END BASE JS -->
    <!-- BEGIN PLUGINS JS -->
    <script src="~/assets/vendor/particles.js/particles.min.js"></script>
    <!-- END PLUGINS JS -->
    <!-- BEGIN THEME JS -->
    <script src="assets/javascript/theme.js"></script> <!-- END THEME JS -->

    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', 'UA-116692175-1');
    </script>
</body>
</html>
